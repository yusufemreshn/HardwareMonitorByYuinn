{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "File": {
      "Directory": "logs",
      "FileNamePrefix": "hardwaremonitor",
      "RetainedFileCountLimit": 14,
      "MaxFileSizeBytes": 10485760
    }
  },
  "AllowedHosts": "127.0.0.1;localhost"
}
