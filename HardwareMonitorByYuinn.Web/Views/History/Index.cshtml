@model HardwareMonitorByYuinn.Web.Models.HistoryViewModel
@{
    ViewData["Title"] = Localizer["Geçmiş"];
}

<div class="settings-shell">
    <nav class="settings-sidebar" id="history-sidebar">
        <button type="button" class="sidebar-toggle" aria-label="@Localizer["Menüyü daralt/genişlet"]" aria-pressed="false">
            <span></span><span></span><span></span>
        </button>
        <div class="settings-category" data-category="report">
            <button type="button" class="settings-category-toggle">
                @Localizer["Sistem Raporu"] <span class="chevron">›</span>
            </button>
            <ul class="settings-subnav">
                <li><button type="button" data-target="history-report-panel">@Localizer["Sistem Raporu"]</button></li>
            </ul>
        </div>
        <div class="settings-category" data-category="rows">
            <button type="button" class="settings-category-toggle">
                @Localizer["Kayıtlar"] <span class="chevron">›</span>
            </button>
            <ul class="settings-subnav">
                <li><button type="button" data-target="history-summary-panel">@Localizer["Kayıt Bilgileri"]</button></li>
                <li><button type="button" data-target="history-rows-panel">@Localizer["Kayıtları Görüntüle"]</button></li>
            </ul>
        </div>
        <div class="settings-category" data-category="trends">
            <button type="button" class="settings-category-toggle">
                @Localizer["Analiz ve Trendler"] <span class="chevron">›</span>
            </button>
            <ul class="settings-subnav">
                <li><button type="button" data-target="history-health-trend-panel">@Localizer["Sistem Sağlığı Trendi"]</button></li>
                <li><button type="button" data-target="history-heatmap-panel">@Localizer["Isı Haritası"]</button></li>
            </ul>
        </div>
        <div class="settings-category" data-category="processes">
            <button type="button" class="settings-category-toggle">
                @Localizer["Süreç ve Sistem Olayları"] <span class="chevron">›</span>
            </button>
            <ul class="settings-subnav">
                <li><button type="button" data-target="process-history-summary-panel">@Localizer["Kayıt Bilgileri"]</button></li>
                <li><button type="button" data-target="history-process-panel">@Localizer["Process Geçmişi"]</button></li>
                <li><button type="button" data-target="history-events-panel">@Localizer["Sistem Olayı Zaman Çizelgesi"]</button></li>
            </ul>
        </div>
        <div class="settings-category" data-category="games">
            <button type="button" class="settings-category-toggle">
                @Localizer["Oyun Geçmişi"] <span class="chevron">›</span>
            </button>
            <ul class="settings-subnav">
                <li><button type="button" data-target="game-history-summary-panel">@Localizer["Kayıt Bilgileri"]</button></li>
                <li><button type="button" data-target="game-history">@Localizer["Oyun Geçmişi"]</button></li>
            </ul>
        </div>
        <div class="settings-category" data-category="security">
            <button type="button" class="settings-category-toggle">
                @Localizer["Güvenlik"] <span class="chevron">›</span>
            </button>
            <ul class="settings-subnav">
                <li><button type="button" data-target="history-login-summary-panel">@Localizer["Giriş Denemesi Özeti"]</button></li>
                <li><button type="button" data-target="history-login-attempts-panel">@Localizer["Giriş Denemeleri"]</button></li>
            </ul>
        </div>
    </nav>

    <div class="settings-content" id="history-content">
        <div class="panel" id="history-report-panel">
            <h2 class="panel-title">@Localizer["Sistem Raporu"]</h2>
            <p style="color:var(--text-muted);font-size:.9rem;margin:0 0 14px;">
                @Localizer["Genel özet, sağlık puanı trendi ve sistem olaylarını tek sayfada toplayan, yazdırılabilir/PDF'e çevrilebilir bir HTML rapor oluşturur (tarayıcının \"Yazdır → PDF olarak kaydet\"i ile)."]
            </p>
            <div style="margin-top:14px;">
                <a href="/History/Report?days=7" target="_blank" rel="noopener" class="btn-primary-hwmon">📄 @Localizer["HTML Rapor Oluştur"]</a>
            </div>
        </div>

        <div class="panel" id="history-summary-panel">
            <h2 class="panel-title">@Localizer["Kayıt Bilgileri"]</h2>
            <p style="color:var(--text-muted);font-size:.9rem;margin:0 0 14px;">
                @Localizer["Uygulama çalışırken her dakika, o dakikanın ortalama değerleri diske kaydedilir; bu sayede uygulamayı kapatıp açsanız (hatta günler sonra) bile geçmiş kaybolmaz. Kayıtlar en fazla 30 gün saklanır, daha eskisi otomatik silinir."]
            </p>

            @if (Model.Status.SampleCount == 0)
            {
                <p class="stat-sub">@Localizer["Henüz hiç kayıt yok. İlk satır, uygulama açıldıktan yaklaşık bir dakika sonra oluşur."]</p>
            }
            else
            {
                <div class="order-item">
                    <span>@Localizer["Kayıt sayısı"]</span>
                    <span class="stat-sub" style="margin:0;">@Model.Status.SampleCount @Localizer["dakikalık örnek"]</span>
                </div>
                <div class="order-item">
                    <span>@Localizer["Aralık"]</span>
                    <span class="stat-sub" style="margin:0;">
                        @Model.Status.OldestSampleUtc?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") →
                        @Model.Status.NewestSampleUtc?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    </span>
                </div>
                <div class="order-item">
                    <span>@Localizer["Veritabanı boyutu"]</span>
                    <span class="stat-sub" style="margin:0;">@((Model.Status.DatabaseSizeBytes / 1024d / 1024d).ToString("F2")) MB</span>
                </div>
                <div class="order-item" style="margin-top:14px;">
                    <span>@Localizer["Eski kayıtları temizle"]</span>
                    <span style="display:flex;gap:8px;align-items:center;">
                        <select id="history-cleanup-days" class="cleanup-days-select">
                            <option value="1">@Localizer["En eski 1 gün"]</option>
                            <option value="2">@Localizer["En eski 2 gün"]</option>
                            <option value="5">@Localizer["En eski 5 gün"]</option>
                            <option value="10">@Localizer["En eski 10 gün"]</option>
                            <option value="15">@Localizer["En eski 15 gün"]</option>
                            <option value="30">@Localizer["En eski 30 gün"]</option>
                        </select>
                        <button type="button" id="history-cleanup-btn" class="btn-primary-hwmon" style="width:auto;padding:0 12px;">@Localizer["Sil"]</button>
                    </span>
                </div>
                @Html.AntiForgeryToken()
            }
        </div>

        <div class="panel" id="history-rows-panel">
            <h2 class="panel-title">@Localizer["Kayıtları Görüntüle"]</h2>
            <p style="color:var(--text-muted);font-size:.9rem;margin:0 0 14px;">
                @Localizer["Bir tarih aralığı seçip Göster'e basın; o aralıktaki dakikalık kayıtlar aşağıda listelenir. Çok geniş bir aralıkta yalnızca ilk"] @Model.MaxDisplayRows @Localizer["satır gösterilir; daha fazlası için aynı aralığı Dışa Aktar'a basıp indirin. Varsayılan olarak son 1 gün seçilidir."]
            </p>
            <form id="history-filter-form" class="thresholds-form" style="margin-bottom:16px;">
                <label class="threshold-field">@Localizer["Başlangıç"]
                    <input type="datetime-local" id="history-filter-from" style="width:200px;" value="@Model.DefaultFromLocal.ToString("yyyy-MM-ddTHH:mm")" required>
                </label>
                <label class="threshold-field">@Localizer["Bitiş"]
                    <input type="datetime-local" id="history-filter-to" style="width:200px;" value="@Model.DefaultToLocal.ToString("yyyy-MM-ddTHH:mm")" required>
                </label>
                <button type="submit" class="btn-primary-hwmon" style="align-self:flex-end;">@Localizer["Göster"]</button>
                <label class="threshold-field" style="width:auto;">@Localizer["Biçim"]
                    <select id="history-export-format">
                        <option value="csv">CSV (Excel)</option>
                        <option value="json">JSON</option>
                    </select>
                </label>
                <button type="button" id="history-export-btn" class="btn-primary-hwmon" style="align-self:flex-end;">@Localizer["Dışa Aktar"]</button>
            </form>
            <p id="history-rows-note" class="stat-sub" style="display:none;"></p>
            <div class="table-scroll">
                <table class="data-table history-table">
                    <thead>
                        <tr>
                            <th>@Localizer["Zaman"]</th><th>CPU %</th><th>CPU MHz</th><th>CPU W</th><th>CPU °C</th>
                            <th>GPU %</th><th>GPU MHz</th><th>GPU °C</th><th>GPU W</th>
                            <th>RAM %</th><th>FPS</th><th>@Localizer["İnd."] MB/s</th><th>@Localizer["Yük."] MB/s</th>
                        </tr>
                    </thead>
                    <tbody id="history-rows-body">
                        <tr><td colspan="13" class="stat-sub">@Localizer["Bir aralık seçip Göster'e basın."]</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="panel" id="history-health-trend-panel">
            <h2 class="panel-title">@Localizer["Sistem Sağlığı Trendi"]</h2>
            <p style="color:var(--text-muted);font-size:.9rem;margin:0 0 14px;">
                @Localizer["Her günün İşlemci/Ekran Kartı/Bellek ortalamalarına, Ayarlar'daki güncel eşiklerinize göre 0-100 arası bir puan verir (100 = sorunsuz). Kalıcı geçmiş disk sıcaklığı tutmadığı için puan yalnızca bu üçüne dayanır, Panel'deki canlı puandan biraz farklı olabilir."]
            </p>
            <label class="threshold-field" style="width:auto;margin-bottom:14px;">@Localizer["Aralık"]
                <select id="health-trend-days">
                    <option value="7">@Localizer["Son 7 gün"]</option>
                    <option value="14" selected>@Localizer["Son 14 gün"]</option>
                    <option value="30">@Localizer["Son 30 gün"]</option>
                </select>
            </label>
            <div class="table-scroll">
                <table class="data-table">
                    <thead><tr><th>@Localizer["Tarih"]</th><th>@Localizer["Puan"]</th><th>@Localizer["Örnek"]</th></tr></thead>
                    <tbody id="health-trend-body"><tr><td colspan="3" class="stat-sub">@Localizer["Yükleniyor…"]</td></tr></tbody>
                </table>
            </div>
        </div>

        <div class="panel" id="history-heatmap-panel">
            <h2 class="panel-title">@Localizer["Isı Haritası"]</h2>
            <p style="color:var(--text-muted);font-size:.9rem;margin:0 0 14px;">
                @Localizer["Kalıcı geçmişteki sıcaklık verisini gün × saat bazında gösterir. Örneğin akşamları neden daha sıcak çalıştığını görmek için kullanışlıdır. İlk günlerde veri az olduğundan desen zayıf görünebilir, zamanla anlamlı hâle gelir."]
            </p>
            <div style="display:flex;gap:16px;align-items:center;margin-bottom:14px;flex-wrap:wrap;">
                <label class="threshold-field" style="width:auto;">@Localizer["Aralık"]
                    <select id="heatmap-days">
                        <option value="7">@Localizer["Son 7 gün"]</option>
                        <option value="14" selected>@Localizer["Son 14 gün"]</option>
                        <option value="30">@Localizer["Son 30 gün"]</option>
                    </select>
                </label>
                <label class="threshold-field" style="width:auto;">@Localizer["Metrik"]
                    <select id="heatmap-metric">
                        <option value="cpu" selected>@Localizer["İşlemci Sıcaklığı"]</option>
                        <option value="gpu">@Localizer["Ekran Kartı Sıcaklığı"]</option>
                    </select>
                </label>
            </div>
            <div class="table-scroll">
                <table class="data-table heatmap-table" id="heatmap-table"></table>
            </div>
            <div id="heatmap-legend" class="heatmap-legend"></div>
        </div>

        <div class="panel" id="process-history-summary-panel">
            <h2 class="panel-title">@Localizer["Kayıt Bilgileri"]</h2>
            <p style="color:var(--text-muted);font-size:.9rem;margin:0 0 14px;">
                @Localizer["\"Kaynak Kullanımı\" listesinde üst sıralarda görünen her process için dakikalık CPU/RAM kaydı tutulur. Kayıtlar en fazla 30 gün saklanır, daha eskisi otomatik silinir."]
            </p>

            @if (Model.ProcessSamplesStatus.SampleCount == 0)
            {
                <p class="stat-sub">@Localizer["Henüz hiç kayıt yok."]</p>
            }
            else
            {
                <div class="order-item">
                    <span>@Localizer["Kayıt sayısı"]</span>
                    <span class="stat-sub" style="margin:0;">@Model.ProcessSamplesStatus.SampleCount @Localizer["dakikalık örnek"]</span>
                </div>
                <div class="order-item">
                    <span>@Localizer["Aralık"]</span>
                    <span class="stat-sub" style="margin:0;">
                        @Model.ProcessSamplesStatus.OldestSampleUtc?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") →
                        @Model.ProcessSamplesStatus.NewestSampleUtc?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    </span>
                </div>
                <div class="order-item">
                    <span>@Localizer["Veritabanı boyutu"]</span>
                    <span class="stat-sub" style="margin:0;">@((Model.ProcessSamplesStatus.DatabaseSizeBytes / 1024d / 1024d).ToString("F2")) MB</span>
                </div>
                <div class="order-item" style="margin-top:14px;">
                    <span>@Localizer["Eski kayıtları temizle"]</span>
                    <span style="display:flex;gap:8px;align-items:center;">
                        <select id="process-history-cleanup-days" class="cleanup-days-select">
                            <option value="1">@Localizer["En eski 1 gün"]</option>
                            <option value="2">@Localizer["En eski 2 gün"]</option>
                            <option value="5">@Localizer["En eski 5 gün"]</option>
                            <option value="10">@Localizer["En eski 10 gün"]</option>
                            <option value="15">@Localizer["En eski 15 gün"]</option>
                            <option value="30">@Localizer["En eski 30 gün"]</option>
                        </select>
                        <button type="button" id="process-history-cleanup-btn" class="btn-primary-hwmon" style="width:auto;padding:0 12px;">@Localizer["Sil"]</button>
                    </span>
                </div>
                @Html.AntiForgeryToken()
            }
        </div>

        <div class="panel" id="history-process-panel">
            <h2 class="panel-title">@Localizer["Process Geçmişi"]</h2>
            <p style="color:var(--text-muted);font-size:.9rem;margin:0 0 14px;">
                @Localizer["Bir process, \"Kaynak Kullanımı\" listesinde üst sıralarda göründüğü her dakika için ayrıca kaydedilir. Bir process seçip zaman içindeki CPU/RAM eğilimini görün (ör. bir sürecin zamanla belleği artırıp artırmadığı)."]
            </p>
            <div style="display:flex;gap:16px;align-items:center;margin-bottom:14px;flex-wrap:wrap;">
                <label class="threshold-field" style="width:auto;">Process
                    <select id="process-history-name"><option value="">@Localizer["Yükleniyor…"]</option></select>
                </label>
                <label class="threshold-field" style="width:auto;">@Localizer["Aralık"]
                    <select id="process-history-days">
                        <option value="1">@Localizer["Son 1 gün"]</option>
                        <option value="7" selected>@Localizer["Son 7 gün"]</option>
                        <option value="30">@Localizer["Son 30 gün"]</option>
                    </select>
                </label>
            </div>
            <p id="process-history-note" class="stat-sub" style="display:none;"></p>
            <div class="table-scroll">
                <table class="data-table">
                    <thead><tr><th>@Localizer["Zaman"]</th><th>@Localizer["Ort. CPU %"]</th><th>@Localizer["Ort. RAM MB"]</th></tr></thead>
                    <tbody id="process-history-body"><tr><td colspan="3" class="stat-sub">@Localizer["Bir process seçin."]</td></tr></tbody>
                </table>
            </div>
        </div>

        <div class="panel" id="history-events-panel">
            <h2 class="panel-title">@Localizer["Sistem Olayı Zaman Çizelgesi"]</h2>
            <p style="color:var(--text-muted);font-size:.9rem;margin:0 0 14px;">
                @Localizer["Windows Olay Günlüğü'nden okunan başlatma/kapatma/uyku/uyanma/güncelleme olayları listelenir. Örneğin bir sıcaklık artışının o gün bir güncelleme sonrası mı başladığını görmek için kullanışlıdır. Bu olaylar kendi veritabanımıza kaydedilmez, Windows'un kendi günlüğünden anlık okunur."]
            </p>
            <label class="threshold-field" style="width:auto;margin-bottom:14px;">@Localizer["Aralık"]
                <select id="system-events-days">
                    <option value="1" selected>@Localizer["Son 1 gün"]</option>
                    <option value="7">@Localizer["Son 7 gün"]</option>
                    <option value="30">@Localizer["Son 30 gün"]</option>
                </select>
            </label>
            <div class="notify-metrics" id="system-events-type-filter" style="margin-bottom:14px;">
                <label class="notify-metric-field">
                    <input type="checkbox" class="system-events-type-check" value="Başlatma" checked> 🟢 @Localizer["Başlatma"]
                </label>
                <label class="notify-metric-field">
                    <input type="checkbox" class="system-events-type-check" value="Kapatma" checked> 🔴 @Localizer["Kapatma"]
                </label>
                <label class="notify-metric-field">
                    <input type="checkbox" class="system-events-type-check" value="Uykuya Geçiş" checked> 💤 @Localizer["Uykuya Geçiş"]
                </label>
                <label class="notify-metric-field">
                    <input type="checkbox" class="system-events-type-check" value="Uyanma" checked> ☀ @Localizer["Uyanma"]
                </label>
                <label class="notify-metric-field">
                    <input type="checkbox" class="system-events-type-check" value="Güncelleme Yüklendi" checked> 🔄 @Localizer["Güncelleme"]
                </label>
                <label class="notify-metric-field">
                    <input type="checkbox" class="system-events-type-check" value="Kullanıcı İsteğiyle Kapatma/Yeniden Başlatma" checked> ⏻ @Localizer["Kullanıcı İsteğiyle Kapatma/Yeniden Başlatma"]
                </label>
            </div>
            <div class="table-scroll">
                <table class="data-table">
                    <thead><tr><th>@Localizer["Zaman"]</th><th>@Localizer["Tür"]</th><th>@Localizer["Açıklama"]</th></tr></thead>
                    <tbody id="system-events-body"><tr><td colspan="3" class="stat-sub">@Localizer["Yükleniyor…"]</td></tr></tbody>
                </table>
            </div>
        </div>
        <div class="panel" id="game-history-summary-panel">
            <h2 class="panel-title">@Localizer["Kayıt Bilgileri"]</h2>
            <p style="color:var(--text-muted);font-size:.9rem;margin:0 0 14px;">
                @Localizer["Bir oyun en az 30 saniye ön planda kare sunarsa oturumu otomatik kaydedilir. Kayıtlar en fazla 30 gün saklanır, daha eskisi otomatik silinir."]
            </p>

            @if (Model.GameSessionsStatus.SampleCount == 0)
            {
                <p class="stat-sub">@Localizer["Henüz hiç oyun oturumu kaydedilmedi."]</p>
            }
            else
            {
                <div class="order-item">
                    <span>@Localizer["Oturum sayısı"]</span>
                    <span class="stat-sub" style="margin:0;">@Model.GameSessionsStatus.SampleCount @Localizer["oturum"]</span>
                </div>
                <div class="order-item">
                    <span>@Localizer["Aralık"]</span>
                    <span class="stat-sub" style="margin:0;">
                        @Model.GameSessionsStatus.OldestSampleUtc?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") →
                        @Model.GameSessionsStatus.NewestSampleUtc?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    </span>
                </div>
                <div class="order-item">
                    <span>@Localizer["Veritabanı boyutu"]</span>
                    <span class="stat-sub" style="margin:0;">@((Model.GameSessionsStatus.DatabaseSizeBytes / 1024d / 1024d).ToString("F2")) MB</span>
                </div>
                <div class="order-item" style="margin-top:14px;">
                    <span>@Localizer["Eski kayıtları temizle"]</span>
                    <span style="display:flex;gap:8px;align-items:center;">
                        <select id="game-history-summary-cleanup-days" class="cleanup-days-select">
                            <option value="1">@Localizer["En eski 1 gün"]</option>
                            <option value="2">@Localizer["En eski 2 gün"]</option>
                            <option value="5">@Localizer["En eski 5 gün"]</option>
                            <option value="10">@Localizer["En eski 10 gün"]</option>
                            <option value="15">@Localizer["En eski 15 gün"]</option>
                            <option value="30">@Localizer["En eski 30 gün"]</option>
                        </select>
                        <button type="button" id="game-history-summary-cleanup-btn" class="btn-primary-hwmon" style="width:auto;padding:0 12px;">@Localizer["Sil"]</button>
                    </span>
                </div>
                @Html.AntiForgeryToken()
            }
        </div>

        <div class="panel" id="game-history">
            <h2 class="panel-title">@Localizer["Oyun Geçmişi"]</h2>
            <p style="color:var(--text-muted);font-size:.9rem;margin:0 0 14px;">
                @Localizer["Bir oyun en az 30 saniye ön planda kare sunarsa oturumu otomatik kaydedilir. Kesintisiz uzun oturumlar en fazla 15 dakikalık parçalara bölünerek kaydedilir. Buradan bir oyunun geçmiş oturumlarındaki ortalama FPS/sıcaklık trendini görebilirsiniz."]
            </p>
            <label class="threshold-field" style="width:auto;margin-bottom:14px;">@Localizer["Oyun"]
                <select id="game-history-select" style="min-width:240px;"></select>
            </label>
            <div class="table-scroll">
                <table class="data-table">
                    <thead><tr><th>@Localizer["Tarih"]</th><th>@Localizer["Süre"]</th><th>@Localizer["Ort. FPS"]</th><th>@Localizer["Ort. CPU °C"]</th><th>@Localizer["Ort. GPU °C"]</th></tr></thead>
                    <tbody id="game-history-body">
                        <tr><td colspan="5" class="stat-sub">@Localizer["Henüz kayıtlı oyun oturumu yok."]</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="panel" id="history-login-summary-panel">
            <h2 class="panel-title">@Localizer["Giriş Denemesi Özeti"]</h2>
            <p style="color:var(--text-muted);font-size:.9rem;margin:0 0 14px;">
                @Localizer["Yerel Ağa Açma etkinken PIN giriş sayfasına yapılan tüm denemeler kalıcı olarak kaydedilir; bu sayede uygulamayı kapatıp açsanız bile geçmiş kaybolmaz. Kayıtlar en fazla 30 gün saklanır, daha eskisi otomatik silinir."]
            </p>

            @if (Model.LoginAttemptsStatus.SampleCount == 0)
            {
                <p class="stat-sub">@Localizer["Henüz hiç giriş denemesi kaydedilmedi."]</p>
            }
            else
            {
                <div class="order-item">
                    <span>@Localizer["Kayıt sayısı"]</span>
                    <span class="stat-sub" style="margin:0;">@Model.LoginAttemptsStatus.SampleCount @Localizer["deneme"]</span>
                </div>
                <div class="order-item">
                    <span>@Localizer["Aralık"]</span>
                    <span class="stat-sub" style="margin:0;">
                        @Model.LoginAttemptsStatus.OldestSampleUtc?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") →
                        @Model.LoginAttemptsStatus.NewestSampleUtc?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    </span>
                </div>
                <div class="order-item">
                    <span>@Localizer["Veritabanı boyutu"]</span>
                    <span class="stat-sub" style="margin:0;">@((Model.LoginAttemptsStatus.DatabaseSizeBytes / 1024d / 1024d).ToString("F2")) MB</span>
                </div>
                <div class="order-item" style="margin-top:14px;">
                    <span>@Localizer["Eski kayıtları temizle"]</span>
                    <span style="display:flex;gap:8px;align-items:center;">
                        <select id="login-attempts-cleanup-days" class="cleanup-days-select">
                            <option value="1">@Localizer["En eski 1 gün"]</option>
                            <option value="2">@Localizer["En eski 2 gün"]</option>
                            <option value="5">@Localizer["En eski 5 gün"]</option>
                            <option value="10">@Localizer["En eski 10 gün"]</option>
                            <option value="15">@Localizer["En eski 15 gün"]</option>
                            <option value="30">@Localizer["En eski 30 gün"]</option>
                        </select>
                        <button type="button" id="login-attempts-cleanup-btn" class="btn-primary-hwmon" style="width:auto;padding:0 12px;">@Localizer["Sil"]</button>
                    </span>
                </div>
                @Html.AntiForgeryToken()
            }
        </div>

        <div class="panel" id="history-login-attempts-panel">
            <h2 class="panel-title">@Localizer["Giriş Denemeleri"]</h2>
            <p style="color:var(--text-muted);font-size:.9rem;margin:0 0 14px;">
                @Localizer["Yerel Ağa Açma etkinken PIN giriş sayfasına (loopback dışından, yani bu bilgisayarın kendisi hariç) yapılan denemelerin kalıcı kaydıdır. Girilen PIN'in kendisi hiçbir zaman saklanmaz, yalnızca IP, zaman ve sonuç (başarılı/başarısız/kilide yol açtı) tutulur. Diğer kalıcı geçmiş verileriyle aynı 30 günlük saklama süresine tabidir."]
            </p>
            <div class="table-scroll">
                <table class="data-table">
                    <thead><tr><th>@Localizer["Zaman"]</th><th>@Localizer["IP Adresi"]</th><th>@Localizer["Sonuç"]</th></tr></thead>
                    <tbody id="login-attempts-body"><tr><td colspan="3" class="stat-sub">@Localizer["Yükleniyor…"]</td></tr></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/history.js" asp-append-version="true"></script>
    <script src="~/js/heatmap.js" asp-append-version="true"></script>
    <script src="~/js/login-attempts.js" asp-append-version="true"></script>
    <script src="~/js/game-history.js" asp-append-version="true"></script>
}
