@model ErrorViewModel
@{
    ViewData["Title"] = Localizer["Hata"];
}

<div class="panel">
    <h2 class="panel-title" style="color: var(--accent-danger);">@Localizer["Bir hata oluştu"]</h2>
    <p style="color: var(--text-muted);">@Localizer["İsteğiniz işlenirken beklenmeyen bir hata meydana geldi."]</p>

    @if (Model.ShowRequestId)
    {
        <p style="color: var(--text-muted); font-size: .85rem;">
            <strong>@Localizer["İstek Kimliği:"]</strong> <code>@Model.RequestId</code>
        </p>
    }

    <p style="margin-top: 16px;">
        <a asp-controller="Dashboard" asp-action="Index" class="btn-primary-hwmon" style="display:inline-block;text-decoration:none;">@Localizer["Panele Dön"]</a>
    </p>
</div>
